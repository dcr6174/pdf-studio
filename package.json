{
  "name": "pdf-studio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "npm ci",
    "dev": "node scripts/prepare-pdf-assets.mjs && vite",
    "build": "npm run build:public",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --max-warnings 0",
    "db:generate": "drizzle-kit generate",
    "verify": "node checks/verify-engine.mjs",
    "verify:compression": "node checks/verify-jpeg-optimization.mjs && node checks/verify-compression-targets.mjs",
    "verify:analytics": "node checks/verify-analytics.mjs && node checks/verify-tracker.mjs",
    "verify:studio": "node checks/verify-studio.mjs",
    "build:public": "npm run lint:play-studio && npm run verify:play-studio && npx tsc --noEmit && node scripts/prepare-pdf-assets.mjs && node scripts/generate-tool-fixtures.mjs && node scripts/generate-brand-options.mjs && node scripts/generate-site-assets.mjs && vite build --config vite.public.config.ts",
    "deploy:public": "node scripts/deploy-public.mjs",
    "verify:public": "node checks/verify-public-owner.mjs",
    "postinstall": "node scripts/prepare-pdf-assets.mjs",
    "generate:site-assets": "node scripts/generate-site-assets.mjs",
    "generate:test-fixtures": "node scripts/generate-tool-fixtures.mjs",
    "generate:brand-options": "node scripts/generate-brand-options.mjs",
    "verify:text": "node checks/verify-online-text.mjs && node checks/verify-text-advanced.mjs",
    "verify:play-studio": "node checks/verify-audit-gameplay.mjs && node checks/verify-play-studio-ui.mjs && node checks/verify-cricket-game.mjs && node checks/verify-casual-levels.mjs && node checks/verify-hill-game.mjs && node checks/verify-pool-aim.mjs && node checks/verify-spatial-games.mjs",
    "lint:play-studio": "eslint lib/spatial-puzzles.ts lib/line-trail.ts checks/verify-spatial-games.mjs --max-warnings 0 components/untangle-studio.tsx components/one-line-studio.tsx"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@embedpdf/pdfium": "2.15.1",
    "@excalidraw/excalidraw": "0.18.1",
    "@hookform/resolvers": "^5.7.1",
    "@libpdf/core": "^0.5.1",
    "@pdf-lib/fontkit": "^1.1.1",
    "@shadcn/react": "^0.3.0",
    "chess.js": "1.4.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "docx": "^9.8.1",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "gifenc": "1.0.3",
    "input-otp": "^1.4.2",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.2",
    "lucide-react": "^1.31.0",
    "mammoth": "^1.13.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "pptxgenjs": "^4.0.1",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "tesseract.js": "^7.0.0",
    "vaul": "^1.1.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@napi-rs/canvas": "0.1.80",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "@xmldom/xmldom": "0.8.15",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "json-rpc-2.0": "1.7.1",
    "raw-body": "3.0.2",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  },
  "license": "MIT"
}
