{
  "id": "/",
  "name": "PDF Studio",
  "short_name": "PDF Studio",
  "description": "Free PDF tools with on-device document processing.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f8fafc",
  "theme_color": "#6d28d9",
  "icons": [
    {
      "src": "/brand/app-192-v3.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/brand/app-512-v3.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/brand/app-maskable-v3.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Merge PDFs",
      "url": "/#merge"
    },
    {
      "name": "Organize pages",
      "url": "/#organize"
    },
    {
      "name": "Sign a PDF",
      "url": "/#sign"
    }
  ],
  "related_applications": [
    {
      "platform": "webapp",
      "url": "https://pdf-studio.in/manifest.webmanifest",
      "id": "https://pdf-studio.in/"
    }
  ],
  "prefer_related_applications": false
}
